# Exemplo de configuração local — versione este arquivo, nunca o `.env`.
#
#   cp .env.example .env
#   # gere um segredo forte e cole em JWT_SECRET:
#   openssl rand -base64 48
#
# Todo valor abaixo é um placeholder. Nenhuma credencial real pertence a este
# arquivo.

# --- Aplicação ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080

# --- Banco de dados (SQLite) ---
# `mode=rwc` cria o arquivo se não existir; o diretório é criado automaticamente.
DATABASE_URL=sqlite://data/api.db?mode=rwc
# `true` aplica as migrations embutidas no boot. Use `false` quando o deploy
# executar `sqlx migrate run` como passo separado.
RUN_MIGRATIONS=true

# --- Redis (Fase 3) ---
# Opcional no desenvolvimento. Se usar autenticação, informe a senha na URL:
# REDIS_URL=redis://usuario:senha@127.0.0.1:6379
REDIS_URL=

# --- Autenticação ---
# Obrigatório: no mínimo 32 caracteres. NUNCA use este valor de exemplo.
JWT_SECRET=troque-este-segredo-por-um-gerado-com-openssl-rand-base64-48
# TTL do access token, em segundos (padrão 900 = 15 minutos).
JWT_ACCESS_TTL_SECS=900

# --- Primeiro Admin ---
# Preencha as duas variáveis juntas, apenas no primeiro boot. Depois podem ser
# removidas: a rotina é idempotente e não altera um Admin já existente.
# A senha precisa de 12 a 128 caracteres, com maiúscula, minúscula, número e
# símbolo.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Troque-Esta-Senha-2026!

# --- Documentação interativa ---
# Swagger UI e o JSON OpenAPI existem apenas em desenvolvimento.
# Em produção são sempre desabilitados; habilitar ali aborta o boot.
# Em desenvolvimento, `false` desabilita para simular produção.
EXPOSE_API_DOCS=true

# --- Operação ---
# Máximo de requisições HTTP simultâneas. O excesso responde 503.
# MAX_CONCURRENT_REQUESTS=128
# Segundos de espera das conexões em voo após Ctrl+C / fechamento da aba.
# SHUTDOWN_DRAIN_SECS=30

# --- CORS ---
# Origens permitidas, separadas por vírgula. Vazio = nenhuma origem cruzada.
# `*` é rejeitado no boot: liste as origens explicitamente.
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com

# --- Desenvolvimento e logs ---
# Encerra o servidor 10 s após a última aba do navegador fechar.
# Rejeitado quando APP_ENV=production.
SHUTDOWN_ON_TAB_CLOSE=false
RUST_LOG=info,api=debug,tower_http=info
